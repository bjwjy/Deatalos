        "parameters": {
          "hydraulic": {
            "settingDifferentialPa": 5000000,
            "maximumAreaM2": 0.00001,
            "flowCoefficient": 0.67
          }
        }
      },
      {
        "id": "valve",
        "typeId": "valve",
        "definition": {
          "id": "teaching:valve-o",
          "version": 1
        },
        "model": {
          "id": "teaching:valve-o",
          "version": "0.1.0"
        },
        "label": "V1 换向阀",
        "parameters": {
          "spool": {
            "commandTravelM": 0.0003,
            "maximumTravelM": 0.01,
            "diameterM": 0.01,
            "overlapM": 0.00001,
            "frequencyRadPerS": 100,
            "dampingRatio": 1
          },
          "hydraulic": {
            "flowCoefficient": 0.67
          }
        }
      },
      {
        "id": "actuator",
        "typeId": "cylinder",
        "definition": {
          "id": "teaching:cylinder",
          "version": 1
        },
        "model": {
          "id": "teaching:cylinder",
          "version": "0.1.0"
        },
        "label": "C1 液压缸",
        "parameters": {
          "geometry": {
            "capAreaM2": 0.00020106192982974675,
            "rodSideAreaM2": 0.00012252211349000192,
            "strokeM": 0.2,
            "capDeadVolumeM3": 0.0003,
            "rodDeadVolumeM3": 0.0003
          },
          "mechanics": {
            "massKg": 0.3,
            "loadDampingNsPerM": 20000,
            "pistonDampingNsPerM": 215,
            "externalForceN": 0
          },
          "hydraulic": {
            "internalLeakageM3PerSPa": 0
          }
        }
      },
      {
        "id": "controller1",
        "typeId": "dynamic-controller",
        "definition": {
          "id": "teaching:dynamic-controller",
          "version": 1
        },
        "model": {
          "id": "application:dynamic-controller",
          "version": "1.0.0"
        },
        "label": "动态控制器（双击我）",
        "controller": {
          "version": 1,
          "cycles": 1,
          "steps": [
            {
              "id": "forward",
              "name": "① 前进 2 秒",
              "commands": [
                {
                  "componentId": "valve",
                  "kind": "position",
                  "positionId": "extend"
                }
              ],
              "until": {
                "kind": "time",
                "durationS": 2
              },
              "timeoutS": 5
            },
            {
              "id": "dwell",
              "name": "② 停留 1 秒",
              "commands": [
                {
                  "componentId": "valve",
                  "kind": "position",
                  "positionId": "neutral"
                }
              ],
              "until": {
                "kind": "time",
                "durationS": 1
              },
              "timeoutS": 4
            },
            {
              "id": "return",
              "name": "③ 退回 2 秒",
              "commands": [
                {
                  "componentId": "valve",
                  "kind": "position",
                  "positionId": "retract"
                }
              ],
              "until": {
                "kind": "time",
                "durationS": 2
              },
              "timeoutS": 5
            },
            {
              "id": "finish",
              "name": "④ 中位结束 1 秒",
              "commands": [
                {
                  "componentId": "valve",
                  "kind": "position",
                  "positionId": "neutral"
                }
              ],
              "until": {
                "kind": "time",
                "durationS": 1
              },
              "timeoutS": 4
            }
          ]
        },
        "parameters": {}
      }
    ],
    "nodes": [
